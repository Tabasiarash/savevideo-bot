# =============================================================================
# savevideo-bot configuration
# Copy this file to `.env` and fill in the values you need.
# Only BOT_TOKEN is required; every other option has a safe default so the bot
# starts and degrades gracefully when a feature is not configured.
# =============================================================================

# --- Required ---------------------------------------------------------------
# Telegram bot token from @BotFather (never commit the real value).
BOT_TOKEN=

# --- Admins ----------------------------------------------------------------
# Comma-separated numeric Telegram user IDs that may use admin commands.
ADMIN_IDS=

# --- Upload limits ---------------------------------------------------------
# Max file size accepted by the Bot API you use (megabytes).
#   Public Bot API      -> 50
#   Local Bot API server-> up to 2000
# MAX_MB is still accepted as a legacy alias.
# When BOT_API_URL is set and this is unset, it defaults to 2000; the value is
# always clamped to 2000 (Telegram's local-server ceiling).
MAX_UPLOAD_MB=50

# --- Local Bot API server (optional, enables >50 MB uploads) ---------------
# Origin of a self-hosted telegram-bot-api server. Empty = the public cloud API.
# aiogram wants the plain origin here (no /bot<token> suffix).
BOT_API_URL=
# Where the local Bot API server stores its files; /health reports free space.
BOT_API_DATA_DIR=/var/lib/telegram-bot-api
# Credentials for the telegram-bot-api server (from https://my.telegram.org).
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Legacy switches, still honoured: LOCAL_API=true uses LOCAL_API_BASE.
LOCAL_API=false
LOCAL_API_BASE=http://telegram-bot-api:8081

# --- Concurrency and per-user limits ---------------------------------------
MAX_JOBS=2
PER_USER_DAILY_LIMIT=30
COOLDOWN_SECONDS=3
MAX_DURATION_MIN=60
# Max concurrent yt-dlp downloads (YouTube throttles aggressive clients).
YT_MAX_CONCURRENCY=2
# Default height cap for "best" picks unless the user chooses higher.
MAX_VIDEO_HEIGHT=1080

# --- Timeouts (seconds) ----------------------------------------------------
INFO_TIMEOUT=30
DOWNLOAD_TIMEOUT=600
# Upload timeout; large files through a local Bot API server take a while.
UPLOAD_TIMEOUT_SECONDS=3600

# --- Cache -----------------------------------------------------------------
CACHE_TTL_DAYS=30

# --- Maintenance -----------------------------------------------------------
AUTO_UPDATE_YTDLP=true
UPDATE_CHECK_HOURS=24

# --- Anti-blocking (optional) ----------------------------------------------
# Absolute path to a Netscape cookies.txt file (needed for YouTube on many
# datacenter VPS IPs and for login-only content). Leave empty to disable.
# Refresh from a logged-in browser with scripts/refresh_cookies.py.
COOKIES_FILE=
# HTTP/SOCKS proxy passed to yt-dlp, e.g. socks5h://user:pass@127.0.0.1:1080
# A residential/mobile or home (Tailscale) egress is the most reliable way to
# defeat YouTube's "Sign in to confirm you're not a bot" wall from a VPS.
# As a free alternative, use fresh cookies + the bundled PO-token provider
# (scripts/run-pot-provider.sh) and JS_RUNTIME=node -- see README.
PROXY_URL=

# --- YouTube / extraction tuning (optional) --------------------------------
# Extra yt-dlp CLI args, appended as-is (shell-quoted). Example:
#   YTDLP_EXTRA_ARGS=--extractor-args "youtube:player_client=web_safari"
YTDLP_EXTRA_ARGS=
# Force IPv4 for every request. Default false (safe).
FORCE_IPV4=false
# Force IPv6, applied ONLY to YouTube URLs. Default false. Note: this is NOT a
# reliable fix for the bot-wall and breaks IPv4-only sites if applied globally.
FORCE_IPV6=false
# JS runtime for yt-dlp (helps with YouTube's JS challenges). "auto" prefers
# Deno then Node >= 22. Accepts "deno", "node", or "name:path".
# YTDLP_JS_RUNTIME is the preferred name; JS_RUNTIME is still accepted.
YTDLP_JS_RUNTIME=auto
# Metadata-only URL used by /health to verify the configured egress works.
EGRESS_TEST_URL=https://www.youtube.com/watch?v=jNQXAC9IVRw

# --- Storage ---------------------------------------------------------------
DB_PATH=data/savevideo.db
TEMP_DIR=tmp
LOG_LEVEL=INFO

# --- Localisation ----------------------------------------------------------
# Fallback language when the user's Telegram language_code is unsupported.
DEFAULT_LANGUAGE=en
