# =============================================================================
# savevideo-bot configuration
# Copy this file to `.env` and fill in the values you need.
# Only BOT_TOKEN is required; every other option has a safe default so the bot
# starts and degrades gracefully when a feature is not configured.
# =============================================================================

# --- Required ---------------------------------------------------------------
# Telegram bot token from @BotFather (never commit the real value).
BOT_TOKEN=

# --- Admins ----------------------------------------------------------------
# Comma-separated numeric Telegram user IDs that may use admin commands.
ADMIN_IDS=

# --- Upload limits ---------------------------------------------------------
# Max file size accepted by the Bot API you use.
#   Public Bot API      -> 50
#   Local Bot API server-> 2000
MAX_MB=50

# --- Local Bot API server (optional, enables >50 MB uploads) ---------------
# Set to true to talk to a self-hosted telegram-bot-api instead of api.telegram.org.
LOCAL_API=false
# Base URL of the local Bot API server (must end with /bot<token> path prefix
# only when you build it yourself; aiogram wants the plain origin here).
LOCAL_API_BASE=http://telegram-bot-api:8081
# Credentials for the telegram-bot-api container (from https://my.telegram.org).
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# --- Concurrency and per-user limits ---------------------------------------
MAX_JOBS=2
PER_USER_DAILY_LIMIT=30
COOLDOWN_SECONDS=3
MAX_DURATION_MIN=60

# --- Timeouts (seconds) ----------------------------------------------------
INFO_TIMEOUT=30
DOWNLOAD_TIMEOUT=600

# --- Cache -----------------------------------------------------------------
CACHE_TTL_DAYS=30

# --- Maintenance -----------------------------------------------------------
AUTO_UPDATE_YTDLP=true
UPDATE_CHECK_HOURS=24

# --- Anti-blocking (optional) ----------------------------------------------
# Absolute path to a Netscape cookies.txt file (needed for YouTube on many
# datacenter VPS IPs and for login-only content). Leave empty to disable.
COOKIES_FILE=
# HTTP/SOCKS proxy passed to yt-dlp, e.g. socks5://127.0.0.1:1080
PROXY_URL=

# --- Storage ---------------------------------------------------------------
DB_PATH=data/savevideo.db
TEMP_DIR=tmp
LOG_LEVEL=INFO

# --- Localisation ----------------------------------------------------------
# Fallback language when the user's Telegram language_code is unsupported.
DEFAULT_LANGUAGE=en
