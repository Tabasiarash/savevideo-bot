# =============================================================================
# savevideo-bot configuration
# Copy this file to `.env` and fill in the values you need.
# Only BOT_TOKEN is required; every other option has a safe default so the bot
# starts and degrades gracefully when a feature is not configured.
# =============================================================================

# --- Required ---------------------------------------------------------------
# Telegram bot token from @BotFather (never commit the real value).
BOT_TOKEN=

# --- Admins ----------------------------------------------------------------
# Comma-separated numeric Telegram user IDs that may use admin commands.
ADMIN_IDS=

# --- Upload limits ---------------------------------------------------------
# Max file size accepted by the Bot API you use (megabytes).
#   Public Bot API      -> 50
#   Local Bot API server-> up to 2000
# MAX_MB is still accepted as a legacy alias.
# When BOT_API_URL is set and this is unset, it defaults to 2000; the value is
# always clamped to 2000 (Telegram's local-server ceiling).
MAX_UPLOAD_MB=50

# --- Local Bot API server (optional, enables >50 MB uploads) ---------------
# Origin of a self-hosted telegram-bot-api server. Empty = the public cloud API.
# aiogram wants the plain origin here (no /bot<token> suffix).
BOT_API_URL=
# Where the local Bot API server stores its files; /health reports free space.
BOT_API_DATA_DIR=/var/lib/telegram-bot-api
# Credentials for the telegram-bot-api server (from https://my.telegram.org).
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Legacy switches, still honoured: LOCAL_API=true uses LOCAL_API_BASE.
LOCAL_API=false
LOCAL_API_BASE=http://telegram-bot-api:8081

# --- Concurrency and per-user limits ---------------------------------------
MAX_JOBS=2
PER_USER_DAILY_LIMIT=30
COOLDOWN_SECONDS=3
MAX_DURATION_MIN=60
# Max concurrent yt-dlp downloads (YouTube throttles aggressive clients).
YT_MAX_CONCURRENCY=2

# --- Download links (over-limit delivery) ----------------------------------
# Files larger than MAX_UPLOAD_MB are never split or re-encoded: the bot keeps
# the finished file and returns a signed, expiring URL served by nginx.
# Links stay disabled until BOT_API_URL, DOWNLOAD_LINK_BASE_URL and
# DOWNLOAD_LINK_SECRET are all set.
# Public origin that serves DOWNLOAD_LINK_DIR (no trailing slash).
DOWNLOAD_LINK_BASE_URL=
# Shared secret; must equal the value in nginx `secure_link_md5` (keep it out
# of any committed nginx.conf — include a chmod 600 file instead).
DOWNLOAD_LINK_SECRET=
# Directory of finished files. MUST be on the same filesystem as TEMP_DIR so
# moving a file into place is an instant rename, not a copy.
DOWNLOAD_LINK_DIR=/srv/savevideo-links
# How long a link stays valid, in hours.
DOWNLOAD_LINK_TTL_HOURS=6
# Max simultaneous active links per user, and a global byte cap for all links.
DOWNLOAD_LINK_MAX_ACTIVE=3
DOWNLOAD_LINK_MAX_TOTAL_GB=20

# --- Disk guard -------------------------------------------------------------
# Refuse to start a download when free space on TEMP_DIR drops below this.
MIN_FREE_DISK_GB=5

# --- Timeouts (seconds) ----------------------------------------------------
INFO_TIMEOUT=30
DOWNLOAD_TIMEOUT=600
# Upload timeout; large files through a local Bot API server take a while.
UPLOAD_TIMEOUT_SECONDS=3600

# --- Cache -----------------------------------------------------------------
CACHE_TTL_DAYS=30

# --- Maintenance -----------------------------------------------------------
AUTO_UPDATE_YTDLP=true
UPDATE_CHECK_HOURS=24

# --- Anti-blocking (optional) ----------------------------------------------
# Absolute path to a Netscape cookies.txt file. Fresh cookies from a logged-in
# account clear YouTube's "Sign in to confirm you're not a bot" wall on most
# datacenter VPS IPs, together with a JS runtime for yt-dlp's built-in PO-token
# (EJS) solver. Refresh from a browser with scripts/refresh_cookies.py.
COOKIES_FILE=
# HTTP/SOCKS proxy passed to yt-dlp, e.g. socks5h://user:pass@127.0.0.1:1080
# A residential/mobile or home (Tailscale) egress is the most reliable way to
# defeat per-IP walls from a VPS, but is optional when cookies + EJS already
# clear the wall. See deploy/home-socks/ for a ready-made tailnet SOCKS egress.
PROXY_URL=
# Per-platform proxy overrides. Each falls back to PROXY_URL when unset, so you
# can route only the sites that need the home egress and let the rest go direct.
PROXY_URL_INSTAGRAM=
PROXY_URL_TIKTOK=
PROXY_URL_X=
PROXY_URL_SOUNDCLOUD=
PROXY_URL_SPOTIFY=

# --- Spotify (metadata-match; off by default) ------------------------------
# Spotify has no download support and the bot never touches DRM. When enabled,
# a Spotify link is read for metadata (oEmbed + page tags, no credentials) and
# the bot searches the configured sources for a downloadable match, then offers
# the normal audio picker. Leave ENABLE_SPOTIFY unset to keep the feature off;
# the router is always registered, so links get a clear "disabled" message.
ENABLE_SPOTIFY=false
# Comma-separated match sources in priority order. Supported: youtube, soundcloud.
SPOTIFY_MATCH_SOURCES=youtube,soundcloud
# Minimum match score (0-1) before a candidate is offered.
SPOTIFY_MIN_SCORE=0.65
# Allowed track-length difference, in seconds, when scoring a candidate.
SPOTIFY_DURATION_TOLERANCE_S=4
# Playlists/albums/shows/artists are only expanded when this is true AND Web API
# credentials below are set (the API is needed to enumerate collection tracks).
SPOTIFY_ENABLE_COLLECTIONS=false
# Hard cap on items processed per collection link.
SPOTIFY_MAX_ITEMS=25
# Optional Spotify Web API credentials. Without them, collections are skipped
# and track metadata falls back to oEmbed + page tags only.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Max parallel metadata fetches for a collection.
SPOTIFY_META_CONCURRENCY=4

# --- Podcast episodes (publisher feed; off by default) ---------------------
# When enabled, a Spotify EPISODE link is resolved to the publisher's own audio
# (iTunes Search -> the show's RSS enclosure -> a YouTube/SoundCloud match as a
# labelled last resort). Spotify audio itself is DRM-protected and never
# fetched. Independent of ENABLE_SPOTIFY: episodes work with it off. A SHOW link
# gets a short "send an episode link" reply (single episodes only for now).
#
# Privacy: an episode's title and show name are sent to Apple's iTunes Search API.
ENABLE_PODCASTS=false
# Fallback match sources when no publisher enclosure exists.
PODCAST_MATCH_SOURCES=youtube,soundcloud
# Minimum score (0-1) for a publisher match, and a stricter bar for the
# YouTube/SoundCloud last resort (used only for Spotify-exclusive episodes).
PODCAST_MIN_SCORE=0.65
PODCAST_EXCLUSIVE_MIN_SCORE=0.8
# Duration tolerance is percentage-based (dynamic ads change lengths): a
# candidate within max(PODCAST_DURATION_TOL_MIN_S, PCT * duration) matches.
PODCAST_DURATION_TOL_MIN_S=30
PODCAST_DURATION_TOL_PCT=0.03
# Longest episode accepted, in minutes, and the hard cap on a single enclosure.
# The enclosure cap only stops abuse: at 128 kbps a 240-minute episode is about
# 230 MB, so 500 MB comfortably fits normal long episodes without letting one
# request pull a gigabyte onto the disk. If the cap is hit, the bot replies with
# the publisher's own URL (it never fetches the file). A file that downloads but
# exceeds MAX_UPLOAD_MB is delivered as a hosted link.
PODCAST_MAX_DURATION_MIN=240
PODCAST_MAX_ENCLOSURE_MB=500
# iTunes storefronts to search, in priority order (shows are regional).
PODCAST_REGIONS=us,de
# RSS feed caps (feeds are untrusted input). Cooldown after an iTunes 403/429.
PODCAST_MAX_FEED_BYTES=10485760
PODCAST_MAX_FEED_ITEMS=200
PODCAST_ITUNES_COOLDOWN_S=300
# Optional proxy for podcast HTTP (metadata + enclosure), no cookies.
PROXY_URL_PODCAST=

# --- YouTube / extraction tuning (optional) --------------------------------
# Extra yt-dlp CLI args, appended as-is (shell-quoted). Example:
#   YTDLP_EXTRA_ARGS=--extractor-args "youtube:player_client=web_safari"
YTDLP_EXTRA_ARGS=
# Force IPv4 for every request. Default false (safe).
FORCE_IPV4=false
# Force IPv6, applied ONLY to YouTube URLs. Default false. Note: this is NOT a
# reliable fix for the bot-wall and breaks IPv4-only sites if applied globally.
FORCE_IPV6=false
# JS runtime for yt-dlp (helps with YouTube's JS challenges). "auto" prefers
# Deno then Node >= 22. Accepts "deno", "node", or "name:path".
# YTDLP_JS_RUNTIME is the preferred name; JS_RUNTIME is still accepted.
YTDLP_JS_RUNTIME=auto
# Metadata-only URL used by /health to verify the configured egress works.
EGRESS_TEST_URL=https://www.youtube.com/watch?v=jNQXAC9IVRw

# --- Storage ---------------------------------------------------------------
DB_PATH=data/savevideo.db
TEMP_DIR=tmp
LOG_LEVEL=INFO

# --- Localisation ----------------------------------------------------------
# Fallback language when the user's Telegram language_code is unsupported.
DEFAULT_LANGUAGE=en
