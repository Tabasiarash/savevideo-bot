# Configuration for deploy/home-socks/home-socks.service.
# Install to /etc/savevideo-bot/home-socks.env (chmod 600, owned by savevideo).

# Home machine reachable over Tailscale / SSH.
# Typical Linux host: SSH on 22 with a normal user.
HOME_SOCKS_HOST=100.x.y.z
HOME_SOCKS_PORT=22
HOME_SOCKS_USER=arash

# Android phone running Termux (sshd defaults to port 8022):
#   HOME_SOCKS_HOST=<phone Tailscale IP, e.g. 100.82.139.15>
#   HOME_SOCKS_PORT=8022
#   HOME_SOCKS_USER=<Termux user from `whoami`, e.g. u0_a497>

# Private key that can log in to the home host (owned by the savevideo user).
HOME_SOCKS_KEY=/etc/savevideo-bot/id_home_socks

# Loopback port the bot then uses as PROXY_URL=socks5h://127.0.0.1:<port>.
# Must be FREE on the VPS: 1080 is commonly taken by an existing SOCKS server,
# so this example uses 1090.
HOME_SOCKS_LOCAL_PORT=1090
