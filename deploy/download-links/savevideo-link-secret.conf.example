# nginx include that defines the shared secret used to sign download links.
#
# Create the real file outside the repository and keep it private:
#
#   printf 'set $download_link_secret "%s";\n' "$(openssl rand -hex 32)" \
#       | sudo tee /etc/nginx/savevideo-link-secret.conf >/dev/null
#   sudo chown root:www-data /etc/nginx/savevideo-link-secret.conf
#   sudo chmod 640 /etc/nginx/savevideo-link-secret.conf
#
# Then put the SAME value in the bot's .env as DOWNLOAD_LINK_SECRET and reload
# nginx. The file is `include`d inside the server{} block, so `set` is valid.
# Never commit the real secret.

set $download_link_secret "REPLACE_WITH_A_RANDOM_HEX_SECRET";
