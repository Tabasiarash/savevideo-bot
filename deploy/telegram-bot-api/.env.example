# Credentials for the local Bot API server, from https://my.telegram.org.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Host path shared with the bot (must equal the bot's TEMP_DIR).
BOT_TMP=/opt/savevideo-bot/tmp

# Host directory for the server's data (matches the bot's BOT_API_DATA_DIR,
# which /health uses to show free space).
BOT_API_DATA=/var/lib/telegram-bot-api
